# Optional: MapTiler key for nicer map tiles (falls back to OpenStreetMap without it)
VITE_MAPTILER_KEY=
# Optional: a custom map made in the MapTiler editor (defaults to the Turnly map)
VITE_MAPTILER_MAP_ID=

# Optional: override the Firebase web config (defaults to the turnly-72b21 project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
