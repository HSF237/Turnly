rules_version = '2';

// Turnly Firestore rules.
// Places, school events and today's tickets are public to read (TV boards and the map need them).
// Only the owner can run a place; anyone signed in (guests included) can join a queue.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(placeId) {
      return signedIn() && get(/databases/$(database)/documents/places/$(placeId)).data.ownerUid == request.auth.uid;
    }
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /schoolEvents/{eventId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /places/{placeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      // The owner can change anything. Customers joining/leaving may only touch the queue counters.
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (
          request.resource.data.ownerUid == resource.data.ownerUid
          && onlyKeys(['lastTicket', 'waiting', 'dayKey', 'servedToday', 'updatedAt'])
        )
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /tickets/{ticketId} {
        allow read: if true;
        allow create: if signedIn()
          && (request.resource.data.uid == request.auth.uid || isOwner(placeId))
          && request.resource.data.status == 'waiting';
        allow update: if signedIn() && (
          // Customers update their own ticket (leave, done, check in, busy elsewhere); the owner updates any.
          resource.data.uid == request.auth.uid
          || isOwner(placeId)
          // Swap my spot: two waiting tickets may trade numbers / carry a swap request.
          || (
            resource.data.status == 'waiting'
            && request.resource.data.status == 'waiting'
            && onlyKeys(['number', 'swapRequest', 'swappedAt'])
          )
        );
        allow delete: if isOwner(placeId);
      }
    }
  }
}
